<div class="min-h-screen bg-gray-50 flex items-center justify-center px-4">
  <div class="w-full max-w-sm rounded-lg border border-gray-300 bg-white shadow-sm">

    <div class="p-6 text-center">
      <h1 class="text-xl font-semibold">Create Account</h1>
      <p class="text-sm text-gray-500 mt-2">
        Start tracking your property search
      </p>
    </div>

    <div class="p-6">
      <%= form_for(resource,
                   as: resource_name,
                   url: registration_path(resource_name)) do |f| %>


        <div class="mb-4">
          <%= f.label :name, class: "block text-sm font-medium mb-2" %>

          <%= f.text_field :name,
                placeholder: "Your name",
                class: "w-full rounded-md border border-gray-300 px-3 py-2" %>

          <% if resource.errors[:name].any? %>
            <p class="mt-1 text-sm text-red-600">
              <%= resource.errors.full_messages_for(:name).first %>
            </p>
          <% end %>
        </div>

        <div class="mb-4">
          <%= f.label :email, class: "block text-sm font-medium mb-2" %>

          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                placeholder: "you@example.com",
                class: "w-full rounded-md border border-gray-300 px-3 py-2" %>

          <% if resource.errors[:email].any? %>
            <p class="mt-1 text-sm text-red-600">
              <%= resource.errors.full_messages_for(:email).first %>
            </p>
          <% end %>
        </div>

        <div class="mb-4">
          <%= f.label :password, class: "block text-sm font-medium mb-2" %>

          <%= f.password_field :password,
                autocomplete: "current-password",
                placeholder: "••••••••",
                class: "w-full rounded-md border border-gray-300 px-3 py-2" %>

          <% if resource.errors[:password].any? %>
            <p class="mt-1 text-sm text-red-600">
              <%= resource.errors.full_messages_for(:password).first %>
            </p>
          <% end %>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation,
                class: "block text-sm font-medium mb-2" %>

          <%= f.password_field :password_confirmation,
                placeholder: "••••••••",
                class: "w-full rounded-md border border-gray-300 px-3 py-2" %>

          <% if resource.errors[:password_confirmation].any? %>
            <p class="mt-1 text-sm text-red-600">
              <%= resource.errors.full_messages_for(:password_confirmation).first %>
            </p>
          <% end %>
        </div>

        <%= f.submit "Sign Up",
              class: "w-full rounded-md bg-blue-700 text-white py-2 hover:bg-blue-500 cursor-pointer" %>

      <% end %>

      <div class="my-5 flex items-center">
        <div class="h-px flex-1 bg-gray-200"></div>
        <span class="mx-4 text-xs uppercase tracking-wide text-gray-400">or</span>
        <div class="h-px flex-1 bg-gray-200"></div>
      </div>

      <%= button_to user_google_oauth2_omniauth_authorize_path,
        method: :post,
        data: { turbo: false },
        class: "mt-4 mb-4 flex w-full items-center justify-center gap-3 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm transition hover:bg-gray-50 hover:border-gray-400" do %>

        <svg xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 48 48"
            class="h-5 w-5"
            aria-hidden="true">
          <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.6 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12S17.4 12 24 12c3 0 5.8 1.1 7.9 2.9l5.7-5.7C34.1 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.4-.4-3.5z"/>
          <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15 19 12 24 12c3 0 5.8 1.1 7.9 2.9l5.7-5.7C34.1 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
          <path fill="#4CAF50" d="M24 44c5.2 0 10-2 13.5-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.2-8l-6.5 5C9.6 39.6 16.2 44 24 44z"/>
          <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-1.1 3.2-3.4 5.7-6.6 7.1l6.2 5.2C38.5 37.1 44 31.2 44 24c0-1.3-.1-2.4-.4-3.5z"/>
        </svg>

        <span>Continue with Google</span>

      <% end %>

      <div class="mt-4 text-center text-sm text-gray-500">

        <p class="mt-2">
          Already have an account?
          <%= link_to "Sign In",
              new_user_session_path,
              class: "text-blue-600 hover:underline" %>
        </p>
      </div>
    </div>

  </div>
</div>





















