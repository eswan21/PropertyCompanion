<div class="min-h-screen bg-gray-50 flex items-center justify-center px-4">
  <div class="w-full max-w-sm rounded-lg border border-gray-300 bg-white shadow-sm">

    <div class="p-6 text-center">
      <h1 class="text-xl font-semibold">Change your password</h1>
      <p class="text-sm text-gray-500 mt-2">
        Welcome back to Property Journal
      </p>
    </div>

    <div class="p-6">
      <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
          <%= render "devise/shared/error_messages", resource: resource %>
          <%= f.hidden_field :reset_password_token %>

        <div class="mb-4">
          <p><%= f.label :password, "New password", class: "block text-sm font-medium mb-2" %></p>
          <p><%= f.password_field :password, autofocus: true, autocomplete: "new-password", placeholder: "••••••••", class: "w-full rounded-md border border-gray-300 px-3 py-2" %></p>
        </div>

        <div class="mb-4">
          <p><%= f.label :password_confirmation, "Confirm new password", class: "block text-sm font-medium mb-2" %></p>
          <p><%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "••••••••", class: "w-full rounded-md border border-gray-300 px-3 py-2" %></p>
        </div>

        <%= f.submit "Change my password",
              class: "w-full rounded-md bg-blue-700 text-white py-2 hover:bg-blue-500 cursor-pointer" %>

      <% end %>

      <div class="mt-4 text-center text-sm">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>



