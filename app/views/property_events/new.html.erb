<div class="max-w-md mx-auto bg-white rounded-xl border border-gray-200 p-6">
  <div class="mb-6">
    <h2 class="text-xl font-semibold text-gray-900">Add Event</h2>

    <% if @property.present? %>
      <p class="mt-1 text-sm text-gray-500">
        <%= @property.title || @property.address %>
      </p>
    <% end %>
  </div>

  <%= form_with model: [@property.search, @property, @property_event],
                class: "space-y-6" do |form| %>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-3">
        Event Type
      </label>

      <div class="flex gap-6">
        <label class="flex items-center gap-2 cursor-pointer">
          <%= form.radio_button :event_type,
                                "viewed",
                                checked: true,
                                class: "h-4 w-4 text-blue-600" %>

          <span class="text-sm text-gray-700">
            Viewed
          </span>
        </label>

        <label class="flex items-center gap-2 cursor-pointer">
          <%= form.radio_button :event_type,
                                "other",
                                class: "h-4 w-4 text-blue-600" %>

          <span class="text-sm text-gray-700">
            Other
          </span>
        </label>
      </div>
    </div>

    <div>
      <%= form.label :note,
                     class: "block text-sm font-medium text-gray-700 mb-2" %>

      <%= form.text_area :note,
                         rows: 4,
                         placeholder: "Add a note...",
                         class: "w-full rounded-lg border border-gray-300 px-3 py-2 focus:border-blue-500 focus:ring-blue-500" %>
    </div>

    <div class="flex justify-end gap-3 pt-2">
      <%= link_to "Cancel",
                  search_property_path(@property.search, @property),
                  class: "rounded-lg border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" %>

      <%= form.submit "Save Event",
                      class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
    </div>

  <% end %>
</div>