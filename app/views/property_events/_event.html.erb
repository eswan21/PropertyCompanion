<div class="flex items-start gap-3">
  <span class="mt-0.5 shrink-0 rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-700">
    <%= event.event_type.titleize %>
  </span>

  <div class="min-w-0 flex-1">
    <% if event.note.present? %>
      <p class="text-sm text-gray-900">
        <%= event.note %>
      </p>
    <% end %>

    <%= render "property_events/gallery", event: event %>

    <p class="mt-1 text-xs text-gray-500">
      <%= event.creator.name %> · <%= event.created_at.strftime("%d %b %Y, %H:%M") %>
    </p>
  </div>
</div>