<% if event.photos.attached? %>
  <div data-controller="event-gallery" class="mt-3">
    <div class="flex flex-wrap gap-2">
      <% visible_photos = event.photos.first(4) %>
      <% hidden_count = event.photos.count - visible_photos.size %>

      <% visible_photos.each do |photo| %>
        <button type="button"
                data-action="click->event-gallery#open"
                data-full-url="<%= url_for(photo) %>"
                class="h-20 w-20 overflow-hidden rounded-lg border border-gray-200 cursor-pointer">
          <%= image_tag photo,
                class: "h-full w-full object-cover" %>
        </button>
      <% end %>

      <% if hidden_count.positive? %>
        <button type="button"
                data-action="click->event-gallery#open"
                data-full-url="<%= url_for(event.photos.first) %>"
                class="flex h-20 w-20 items-center justify-center rounded-lg border border-gray-200 bg-gray-100 text-s font-semibold text-gray-700 hover:bg-gray-200 cursor-pointer">

          +<%= hidden_count %>

        </button>
      <% end %>
    </div>

    <%= render "property_events/gallery_modal", event: event %>
  </div>
<% end %>