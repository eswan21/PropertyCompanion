<header class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">

      <div class="flex items-center gap-6">
        <h1 class="text-2xl font-bold">Property Journal</h1>

        <%= link_to searches_path,
          class: "flex items-center gap-2 rounded-lg px-4 py-3 text-lg font-medium
            #{current_page?(searches_path) ? 'bg-gray-100' : 'bg-white hover:bg-gray-100'}" do %>
          <span>
            <svg xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-house-icon lucide-house">
              <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/>
              <path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            </svg>
          </span>
          <span>My Searches</span>
        <% end %>
      </div>

      <details class="relative">
        <summary class="flex items-center gap-2 text-lg font-medium px-4 py-3 rounded-lg hover:bg-gray-100 cursor-pointer list-none">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
          </svg>

          <span><%= current_user.name %></span>
        </summary>

        <div class="absolute right-0 mt-2 w-30 rounded-lg border border-gray-200 bg-white shadow-lg z-50">
          <%= button_to "Sign Out",
              destroy_user_session_path,
              method: :delete,
              class: "w-full text-left px-4 py-3 hover:bg-gray-100 cursor-pointer" %>
        </div>
      </details>

    </div>
</header>