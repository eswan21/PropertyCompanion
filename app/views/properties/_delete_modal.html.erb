<div data-controller="modal">
  <button type="button" data-action="click->modal#open" class="flex items-center gap-3 rounded-lg border border-gray-300 hover:border-red-200 bg-white px-3 py-2 text-sm text-gray-700 hover:text-red-600 hover:bg-red-100">
    <svg xmlns="http://www.w3.org/2000/svg"
        width="15"
        height="15"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round">
      <path d="M3 6h18"/>
      <path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/>
      <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
    </svg>

    <span>Delete</span>
  </button>

  <div data-modal-target="window" class="hidden fixed inset-0 z-50">
    <div class="fixed inset-0 bg-black/40" data-action="click->modal#close"></div>

    <div class="fixed inset-0 flex items-center justify-center p-4">
      <div class="w-full max-w-md rounded-lg bg-white p-6 shadow-lg">
        <h2 class="text-xl font-semibold mb-3">Delete Property</h2>

        <p class="text-gray-500 mb-6">
            Are you sure you want to delete "<%= @property.title %>"?
        </p>

        <div class="flex justify-end gap-3">
            <button type="button"
                            data-action="click->modal#close"
                            class="rounded-md border border-gray-300 px-4 py-2 hover:bg-gray-50 cursor-pointer">
                Cancel
            </button>

            <%= button_to "Delete",
                        search_property_path(@search, @property),
                        method: :delete,
                        class: "cursor-pointer rounded-md bg-red-500 px-4 py-2 text-white hover:bg-red-600" %>
        </div>
      </div>
    </div>
  </div>
</div>