<% is_closing = property.open? %>

<div class="max-w-md rounded-xl border border-gray-200 bg-white p-6">
  <div class="mb-6">
    <h2 class="text-xl font-semibold text-gray-900">
      <%= is_closing ? "Mark as Closed" : "Reopen Property" %>
    </h2>

    <p class="mt-1 text-sm text-gray-500">
      <%= property.address %>
    </p>
  </div>

  <%= form_with url: toggle_status_search_property_path(search, property),
                method: :patch,
                class: "space-y-4" do |form| %>

    <div>
      <%= form.label :note,
                     "Note (optional)",
                     class: "block text-sm font-medium text-gray-700 mb-2" %>

      <%= form.text_area :note,
                         rows: 3,
                         placeholder: "Add a reason...",
                         class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-500 focus:ring-blue-500" %>
    </div>

    <div class="flex justify-end gap-3 pt-2">
      <%= link_to "Cancel",
                  search_property_path(search, property),
                  class: "rounded-lg border border-gray-300 px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" %>

      <%= form.submit(is_closing ? "Close" : "Reopen",
                      class: "#{is_closing ? 'bg-red-600 hover:bg-red-700' : 'bg-blue-600 hover:bg-blue-700'} rounded-lg px-4 py-2 text-sm font-medium text-white") %>
    </div>
  <% end %>
</div>