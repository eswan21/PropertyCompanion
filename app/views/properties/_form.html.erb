<%= form_with model: [@search, @property], class: "space-y-6" do |form| %>
  <% if @property.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 text-sm text-red-700">
      <p class="font-medium">Please fix the errors below:</p>
      <ul class="mt-2 list-disc pl-5">
          <% @property.errors.full_messages.each do |message| %>
          <li><%= message %></li>
          <% end %>
      </ul>
    </div>
  <% end %>

  <section>
    <h2 class="mb-3 text-sm font-medium text-gray-500">Basic Information</h2>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <label class="mb-1 block text-sm font-medium text-gray-700">
        Title <span class="text-red-500">*</span>
        </label>
        <%= form.text_field :title,
            required: true,
            autofocus: true,
            placeholder: "e.g. Modern 2-bed Apartment",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" %>
      </div>

      <div>
        <%= form.label :price_per_month, "Price / Month (£)", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= form.number_field :price_per_month,
            placeholder: "1200",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" %>
      </div>

      <div>
        <%= form.label :personal_priority, "Priority",
            class: "mb-1 block text-sm font-medium text-gray-700" %>

        <%= form.select :personal_priority,
            [
            ["High", 1],
            ["Medium", 2],
            ["Low", 3]
            ],
            { include_blank: "Select priority" },
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" %>
      </div>

      <div class="sm:col-span-2">
        <%= form.label :location, "Location / Area", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= form.text_field :location,
            placeholder: "e.g. Northern Quarter",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" %>
      </div>
    </div>
  </section>

  <section>
    <h2 class="mb-3 text-sm font-medium text-gray-500">Source & Address</h2>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <%= form.label :url, "URL", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= form.url_field :url,
            placeholder: "https://...",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" %>
      </div>

      <div>
        <%= form.label :address, "Address", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= form.text_field :address,
            placeholder: "42 Tib Street",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" %>
      </div>

      <div>
        <%= form.label :postcode, "Postcode", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= form.text_field :postcode,
            placeholder: "M4 1LA",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" %>
      </div>
    </div>
  </section>

  <section>
    <h2 class="mb-3 text-sm font-medium text-gray-500">Additional Details</h2>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :council_tax_band, "Council Tax Band", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= form.select :council_tax_band,
            options_for_select([["Select Council Tax Band", ""]] + %w[A B C D E F G H].map { |v| [v, v] }, @property.council_tax_band),
            {},
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" %>
      </div>

      <div>
        <%= form.label :epc_rating, "EPC Rating", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= form.select :epc_rating,
            options_for_select([["Select EPC Rating", ""]] + %w[A B C D E F G].map { |v| [v, v] }, @property.epc_rating),
            {},
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" %>
      </div>
    </div>
  </section>

  <section>
    <h2 class="mb-3 text-sm font-medium text-gray-500">Notes</h2>

    <div class="space-y-4">
      <div>
        <%= form.label :disadvantages, "Disadvantages", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= form.text_area :disadvantages,
            rows: 3,
            placeholder: "Any drawbacks...",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" %>
      </div>

      <div>
        <%= form.label :notes, "Notes", class: "mb-1 block text-sm font-medium text-gray-700" %>
        <%= form.text_area :notes,
            rows: 3,
            placeholder: "General notes...",
            class: "w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-blue-700 focus:outline-none focus:ring-1 focus:ring-blue-700" %>
      </div>
    </div>
  </section>

  <div class="flex items-center justify-end gap-3 border-t border-gray-200 pt-6">
    <%= link_to "Cancel",
        search_path(@search),
        class: "rounded-md border border-gray-300 px-4 py-2 hover:bg-gray-50 cursor-pointer" %>

    <%= form.submit "Save Property",
        class: "rounded-md bg-blue-700 px-4 py-2 text-white hover:bg-blue-500 cursor-pointer" %>
  </div>
<% end %>