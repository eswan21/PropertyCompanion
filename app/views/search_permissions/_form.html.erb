<div class="space-y-4">
  <%= form_with model: [search, SearchInvitation.new], class: "flex gap-2 mb-4" do |f| %>

    <div class="flex-1">
      <%= f.email_field :email,
            placeholder: "Email address",
            class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <%= f.submit "Add",
          class: "shrink-0 rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700 cursor-pointer" %>
  <% end %>

  <% if search.shared_users.any? %>
    <div class="space-y-2">
      <p class="text-xs text-gray-500">Collaborators</p>

      <% search.shared_users.each do |collaborator| %>
        <div class="flex items-center justify-between rounded-md bg-gray-100 px-3 py-2 text-sm">
          <span><%= collaborator.email %></span>

          <%= button_to "✕",
                search_search_permission_path(
                  search,
                  search.search_permissions.find_by(user: collaborator)
                ),
                method: :delete,
                class: "text-gray-500 hover:text-red-600 bg-transparent border-0 cursor-pointer",
                form_class: "inline" %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="py-4 text-center text-sm text-gray-500">
      No collaborators yet.
    </p>
  <% end %>
</div>
