<button type="button"
        data-action="click->modal#open"
        onclick="event.preventDefault(); event.stopPropagation();"
        class="p-1.5 rounded-lg hover:bg-red-50 text-gray-500 hover:text-red-500 cursor-pointer">
  <svg xmlns="http://www.w3.org/2000/svg"
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round">
    <path d="M10 11v6"/>
    <path d="M14 11v6"/>
    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
    <path d="M3 6h18"/>
    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
  </svg>
</button>

<div data-modal-target="window"
     class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4">
  <div class="w-full max-w-md rounded-lg bg-white p-6 shadow-lg">
    <h2 class="text-xl font-semibold mb-3">Delete Search</h2>

    <p class="text-gray-500 mb-6">
      Are you sure you want to delete "<%= search.name %>"?
    </p>

    <div class="flex justify-end gap-3">
      <button type="button"
              data-action="click->modal#close"
              onclick="event.preventDefault(); event.stopPropagation();"
              class="rounded-md border border-gray-300 px-4 py-2 hover:bg-gray-50 cursor-pointer">
        Cancel
      </button>

      <%= button_to "Delete",
            search_path(search),
            method: :delete,
            form: {
              data: { turbo_confirm: nil },
              onclick: "event.stopPropagation();"
            },
            class: "rounded-md bg-red-500 px-4 py-2 text-white hover:bg-red-600 cursor-pointer" %>
    </div>
  </div>
</div>