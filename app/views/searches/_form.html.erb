<%= form_with model: search, url: searches_path, class: "space-y-4" do |f| %>
  <div>
    <%= f.label :name, "Search Name", class: "block text-sm font-medium mb-2" %>

    <%= f.text_field :name,
          required: true,
          placeholder: "e.g. Manchester 2-bed search",
          class: "w-full rounded-md border border-gray-300 px-3 py-2" %>

    <% if search.errors[:name].any? %>
      <p class="mt-1 text-sm text-red-600">
        <%= search.errors.full_messages_for(:name).first %>
      </p>
    <% end %>
  </div>

  <div class="flex justify-end gap-3 pt-4">
    <button type="button"
            data-action="click->modal#close"
            class="rounded-md border border-gray-300 px-4 py-2 hover:bg-gray-50 cursor-pointer">
      Cancel
    </button>

    <%= f.submit "Create Search",
          class: "rounded-md bg-blue-700 px-4 py-2 text-white hover:bg-blue-500 cursor-pointer" %>
  </div>
<% end %>