<div class="min-h-screen bg-gray-50 text-gray-900">
  <main>
    <div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <h1 class="text-2xl font-semibold mb-6">Create New Search</h1>

        <%= form_with model: @search, class: "space-y-4" do |f| %>
          <div>
            <%= f.label :name, "Search Name", class: "block text-sm font-medium mb-2" %>
            <%= f.text_field :name,
                  autofocus: true,
                  placeholder: "e.g. Manchester 2-bed search",
                  class: "w-full rounded-md border border-gray-300 px-3 py-2" %>
          </div>

          <div class="flex justify-end gap-3 pt-4">
            <%= link_to "Cancel",
                  searches_path,
                  class: "rounded-md border border-gray-300 px-4 py-2 hover:bg-gray-50" %>

            <%= f.submit "Create Search",
                  class: "rounded-md bg-blue-700 px-4 py-2 text-white hover:bg-blue-500 cursor-pointer" %>
          </div>
        <% end %>
      </div>
    </div>
  </main>
</div>