<div data-controller="modal">
  <button type="button"
          data-action="click->modal#open"
          class="flex items-center gap-3 rounded-lg bg-blue-700 px-6 py-4 text-xl font-medium text-white hover:bg-blue-500 cursor-pointer">
    <span class="text-2xl leading-none">+</span>
    <span>New Search</span>
  </button>

  <div data-modal-target="window"
       class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/40 px-4">
    <div class="w-full max-w-md rounded-lg bg-white shadow-lg border border-gray-200 p-6">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-semibold">Create New Search</h2>

        <button type="button"
                data-action="click->modal#close"
                class="text-gray-500 hover:text-gray-900 cursor-pointer">
          ✕
        </button>
      </div>

      <%= render "searches/form", search: search %>
    </div>
  </div>
</div>