<div class="min-h-screen bg-gray-50 text-gray-900">
  <main>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

      <div class="mb-6">
        <%= link_to searches_path,
            class: "inline-flex items-center gap-2 text-gray-500 hover:text-gray-900" do %>
          <span>←</span>
          <span>My Searches</span>
        <% end %>
      </div>

      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold"><%= @search.name %></h1>

          <p class="mt-2 text-gray-500">
            Updated <%= @search.updated_at.strftime("%Y-%m-%d") %>
          </p>
        </div>

        <div class="flex items-center gap-3">

          <%= render "search_permissions/modal", search: @search %>

          <%= render "properties/new_modal" %>
        </div>
      </div>

      <div class="relative mb-6 max-w-md">
        <input
          type="text"
          placeholder="Search properties..."
          class="w-full rounded-lg border border-gray-300 px-4 py-2"
        >
      </div>

      <% if @properties.any? %>
        <div class="overflow-hidden rounded-xl border border-gray-200 bg-white">
          <table class="w-full table-fixed">
            <thead class="bg-gray-50 text-left text-sm font-medium text-gray-500">
              <tr>
                <th class="w-[10%] px-6 py-4">Location</th>
                <th class="w-[8%] px-6 py-4">Price</th>
                <th class="w-[25%] px-6 py-4">Listing Title</th>
                <th class="w-[5%] px-6 py-4">Tax<br>Band</th>
                <th class="w-[7%] px-6 py-4">Viewed</th>
                <th class="w-[15%] px-6 py-4">Latest Note</th>
                <th class="w-[15%] px-6 py-4">Disadvantages</th>
                <th class="w-[15%] px-6 py-4">Actions</th>
              </tr>
            </thead>

            <tbody class="divide-y divide-gray-200">
              <% @properties.each do |property| %>
                <tr class="<%= property.open? ? 'hover:bg-gray-50' : 'bg-gray-50' %>">
                  <td class="<%= property.open? ? 'text-gray-700' : 'text-gray-300' %> px-6 py-5 ">
                    <%= property.location.presence || "—" %>
                  </td>

                  <td class="<%= property.open? ? 'text-gray-700' : 'text-gray-300' %> px-6 py-5 ">
                    <% if property.price_per_month.present? %>
                      £<%= property.price_per_month %>/mo
                    <% else %>
                      —
                    <% end %>
                  </td>

                  <td class="px-6 py-5">
                    <div class="flex items-center w-full">
                      <div class="flex-1 min-w-0">
                        <%= link_to truncate(property.title, length: 25),
                          search_property_path(@search, property),
                          class: property.open? ?
                            "text-blue-500 hover:text-blue-600 font-medium" :
                            "text-gray-300 hover:text-gray-400 font-medium" %>
                      </div>

                      <div class="ml-3 shrink-0">
                        <% if property.url.present? %>
                          <%= link_to property.url,
                                target: "_blank",
                                class: property.open? ?
                                  "text-gray-500 hover:text-blue-500" :
                                  "text-gray-300 hover:text-gray-400" do %>
                            <svg xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="lucide lucide-external-link-icon lucide-external-link">
                              <path d="M15 3h6v6"/>
                              <path d="M10 14 21 3"/>
                              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                            </svg>
                          <% end %>
                        <% end %>
                      </div>

                      <div class="ml-3 shrink-0">
                        <% if property.personal_priority.present? %>
                          <% case property.personal_priority %>
                          <% when 1 %>
                            <% if property.open? %>
                              <span class="rounded-full border border-red-200 bg-red-50 px-3 py-1 text-xs font-semibold text-red-600">
                                high
                              </span>
                            <% else %>
                              <span class="rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-xs font-semibold text-gray-300">
                                high
                              </span>
                            <% end %>
                          <% when 2 %>
                            <% if property.open? %>
                              <span class="rounded-full border border-yellow-200 bg-yellow-50 px-3 py-1 text-xs font-semibold text-yellow-600">
                                medium
                              </span>
                            <% else %>
                              <span class="rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-xs font-semibold text-gray-300">
                                medium
                              </span>
                            <% end %>
                          <% when 3 %>
                            <% if property.open? %>
                              <span class="rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-xs font-semibold text-gray-500">
                                low
                              </span>
                            <% else %>
                              <span class="rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-xs font-semibold text-gray-300">
                                low
                              </span>
                            <% end %>
                          <% end %>
                        <% end %>
                      </div>
                    </div>
                  </td>

                  <td class="<%= property.open? ? 'text-gray-700' : 'text-gray-300' %> px-6 py-5 ">
                    <%= property.council_tax_band.presence || "—" %>
                  </td>

                  <td class="px-6 py-5">
                    <% if property.viewed? %>
                      <div class="inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-medium
                          <%= property.open? ?
                            'bg-green-100 text-green-700'
                            :
                            'bg-gray-100 text-gray-400' %>">
                          <svg xmlns="http://www.w3.org/2000/svg"
                              width="15"
                              height="15"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              class="lucide lucide-eye-icon lucide-eye">
                            <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/>
                            <circle cx="12" cy="12" r="3"/>
                          </svg>
                        <span>
                          Yes
                        </span>
                      </div>
                    <% else %>
                      <span class="rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-700">
                        No
                      </span>
                    <% end %>
                  </td>

                  <td class="<%= property.open? ? 'text-gray-700' : 'text-gray-300' %> px-6 py-5 max-w-[180px]">
                    <div class="relative group">
                      <span class="block truncate cursor-default" title="<%= property.notes %>">
                        <%= property.notes.present? ? truncate(property.notes, length: 24) : "—" %>
                      </span>
                      <% if property.notes.present? %>
                        <div class="absolute left-1/2 bottom-full z-10 mb-2
                            -translate-x-1/2 rounded-xl border border-gray-200 bg-white
                            px-4 py-3 shadow-lg text-sm w-64
                            whitespace-normal break-words
                            opacity-0 invisible transition-all duration-150
                            group-hover:opacity-100 group-hover:visible <%= property.open? ? 'text-gray-600' : 'text-gray-400' %>">
                          <%= property.notes %>
                        </div>
                      <% end %>
                    </div>
                  </td>

                  <td class="<%= property.open? ? 'text-gray-700' : 'text-gray-300' %> px-6 py-5 max-w-[180px]">
                    <div class="relative group">
                      <span class="block truncate cursor-default" title="<%= property.disadvantages %>">
                        <%= property.disadvantages.present? ? truncate(property.disadvantages, length: 28) : "—" %>
                      </span>
                      <% if property.disadvantages.present? %>
                        <div class="absolute left-1/2 bottom-full z-10 mb-2
                            -translate-x-1/2 rounded-xl border border-gray-200 bg-white
                            px-4 py-3 shadow-lg text-sm w-64
                            whitespace-normal break-words
                            opacity-0 invisible transition-all duration-150
                            group-hover:opacity-100 group-hover:visible <%= property.open? ? 'text-gray-600' : 'text-gray-400' %>">
                          <%= property.disadvantages %>
                        </div>
                      <% end %>
                    </div>
                  </td>

                  <td class ="px-6 py-5">
                    <div class="flex items-center gap-2">

                      <%= render "property_events/modal",
                        search: @search,
                        property: property,
                        button_variant: :icon %>

                      <%= render "properties/status_modal",
                        search: @search,
                        property: property,
                        button_variant: :icon %>

                      <%= link_to "View",
                          search_property_path(@search, property),
                            class: "inline-flex items-center justify-center h-8 px-2 text-sm rounded-lg hover:bg-gray-100
                              #{property.open? ? 'text-gray-500 hover:text-gray-700' : 'text-gray-300 hover:text-gray-400'}" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="rounded-xl border border-gray-200 bg-white p-12 text-center">
          <h2 class="text-lg font-medium mb-2">
            No properties yet
          </h2>

          <p class="text-gray-500 mb-6">
            Add your first property to this search.
          </p>

          <%= render "properties/new_modal" %>
        </div>
      <% end %>
    </div>
  </main>
</div>