<div class="min-h-screen bg-gray-50 text-gray-900">
  
  <main>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex items-center justify-between mb-10">
        <h2 class="text-4xl font-bold">My Searches</h2>

        <%= link_to new_search_path,
            class: "flex items-center gap-3 rounded-lg bg-blue-700 px-6 py-4 text-xl font-medium text-white hover:bg-blue-500" do %>
            <span class="text-2xl leading-none">+</span>
            <span>New Search</span>
        <% end %>
      </div>

      <div class="space-y-5">
        <% @searches.each do |search| %>
            <a href="#" class="block rounded-xl border border-gray-200 bg-white px-5 py-4 shadow-sm hover:shadow-md transition">
            <div class="flex items-center justify-between">
                <div>
                <h3 class="text-xl font-medium"><%= search.name %></h3>

                <div class="flex items-center gap-4 text-xl text-gray-500">
                    <span>2 open</span>
                    <span>·</span>
                    <span>1 closed</span>
                    <span>·</span>
                    <span>Updated <%= search.updated_at.strftime("%Y-%m-%d") %></span>
                </div>
                </div>

                <span class="text-4xl text-gray-500">›</span>
            </div>
            </a>
        <% end %>
      </div>
    </div>
  </main>
</div>
