<div class="min-h-screen bg-gray-50 text-gray-900">
  <main>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
      <div class="flex items-center justify-between mb-10">
        <h2 class="text-4xl font-bold">My Searches</h2>

        <%= render "searches/new_modal", search: @search || Search.new %>
      </div>

      <div class="space-y-5">
        <% if @searches.any? %>
          <% @searches.each do |search| %>
            <%= render "searches/search_card", search: search %>
          <% end %>
        <% else %>
          <div class="rounded-xl border border-gray-200 bg-white p-12 text-center">
            <h2 class="text-lg font-medium mb-2">No searches yet</h2>
            <p class="text-gray-500 mb-6">Create your first search.</p>
          </div>
        <% end %>
      </div>
    </div>
  </main>
</div>











