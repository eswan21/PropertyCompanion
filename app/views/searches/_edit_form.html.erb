<%= form_with model: search, class: "flex items-center gap-3" do |f| %>
  <%= f.text_field :name,
        value: search.name,
        required: true,
        class: "flex-1 rounded-md border border-gray-300 px-3 py-2" %>

  <%= f.submit "Save",
        class: "shrink-0 rounded-md bg-blue-700 px-4 py-2 text-white hover:bg-blue-500 cursor-pointer" %>

  <button type="button"
          data-action="click->search-card#cancel"
          class="shrink-0 rounded-md bg-red-500 text-white px-4 py-2 hover:bg-red-300 cursor-pointer">
    Cancel
  </button>
<% end %>